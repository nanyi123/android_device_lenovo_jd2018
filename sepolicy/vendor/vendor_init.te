#============= vendor_init ==============
allow vendor_init rootfs:dir { add_name create setattr write };
allow vendor_init rootfs:lnk_file setattr;
set_prop(vendor_init, camera_prop)

# SELinux enforcing: vendor_init sets these from vendor.prop at boot.
# Types confirmed from auditd on-device; none violate neverallow.
set_prop(vendor_init, vendor_bluetooth_prop)
set_prop(vendor_init, overlay_prop)
set_prop(vendor_init, persist_debug_prop)
set_prop(vendor_init, vendor_qcom_ims_prop)
set_prop(vendor_init, vendor_reschedule_service_prop)
set_prop(vendor_init, vendor_bservice_prop)